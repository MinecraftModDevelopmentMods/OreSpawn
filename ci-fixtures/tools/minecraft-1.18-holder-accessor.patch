@@ -368,0 +371,22 @@ public final class ProcessUtils {
+    private static void patchMinecraft118HolderAccessor(File sourcesOutput) {
+        var holder = new File(sourcesOutput, "net/minecraft/core/Holder.java");
+        if (!holder.isFile())
+            return;
+
+        try {
+            var source = Files.readString(holder.toPath());
+            var record = "public static record Direct<T>(T value) implements Holder<T>";
+            var accessor = "\n      public T value() {\n         return this.value;\n      }\n";
+            if (!source.contains(record) || !source.contains(accessor))
+                return;
+
+            var patched = source.replace(accessor, "\n");
+            if (patched.contains(accessor))
+                throw new IllegalStateException("Holder.Direct accessor compatibility patch was ambiguous");
+            Files.writeString(holder.toPath(), patched);
+            LOGGER.info("Applied Minecraft 1.18.2 Holder.Direct javac compatibility patch");
+        } catch (IOException e) {
+            throw new RuntimeException("Failed to patch Minecraft 1.18.2 Holder source", e);
+        }
+    }
